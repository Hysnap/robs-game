{
	"_meta": {
		"description": "Crime flavour overlay extending COLLECT_FROM with premises theft (BURGLE, SHOPLIFT) and person-targeted extraction (PICKPOCKET, MUG, ROB).",
		"flavour_overlay": "crime",
		"verb_token": "COLLECT_FROM",
		"version": 1.0
	},
	"parameters": {
		"source_id": {
			"required": false,
			"type": "STRING"
		},
		"target_entity_id": {
			"required": false,
			"type": "STRING"
		}
	},
	"steps": [
		{
			"on_false": "branch_crime_premises_mode",
			"step_id": "branch_collect_mode"
		},
		{
			"on_false": "branch_crime_shoplift",
			"on_true": "gate_premises_stock",
			"params": {
				"domain": "PARAM",
				"metric": "PARAM.mode",
				"operator": "==",
				"value": "BURGLE"
			},
			"primitive": "REQUIRE",
			"step_id": "branch_crime_premises_mode"
		},
		{
			"on_false": "branch_crime_person_mode",
			"on_true": "gate_premises_stock",
			"params": {
				"domain": "PARAM",
				"metric": "PARAM.mode",
				"operator": "==",
				"value": "SHOPLIFT"
			},
			"primitive": "REQUIRE",
			"step_id": "branch_crime_shoplift"
		},
		{
			"on_false": "branch_crime_mug",
			"on_true": "gate_person_source_present",
			"params": {
				"domain": "PARAM",
				"metric": "PARAM.mode",
				"operator": "==",
				"value": "PICKPOCKET"
			},
			"primitive": "REQUIRE",
			"step_id": "branch_crime_person_mode"
		},
		{
			"on_false": "branch_crime_rob",
			"on_true": "gate_person_source_present",
			"params": {
				"domain": "PARAM",
				"metric": "PARAM.mode",
				"operator": "==",
				"value": "MUG"
			},
			"primitive": "REQUIRE",
			"step_id": "branch_crime_mug"
		},
		{
			"on_failure": {
				"error_code": "INVALID_PARAMETER"
			},
			"on_true": "gate_person_source_present",
			"params": {
				"domain": "PARAM",
				"metric": "PARAM.mode",
				"operator": "==",
				"value": "ROB"
			},
			"primitive": "REQUIRE",
			"step_id": "branch_crime_rob"
		},
		{
			"next_step": "gate_source_stock",
			"on_failure": {
				"error_code": "INVALID_TARGET"
			},
			"params": {
				"domain": "PARAM",
				"metric": "PARAM.source_id",
				"operator": "!=",
				"value": ""
			},
			"primitive": "REQUIRE",
			"step_id": "gate_person_source_present"
		},
		{
			"next_step": "transit_premises",
			"on_failure": {
				"error_code": "INSUFFICIENT_RESOURCE"
			},
			"params": {
				"actor": "PARAM.target_entity_id",
				"domain": "COMMODITY",
				"metric": "PARAM.item_id",
				"operator": ">=",
				"value": "PARAM.amount"
			},
			"primitive": "REQUIRE",
			"step_id": "gate_premises_stock"
		},
		{
			"next_step": "gate_premises_co_location",
			"on_failure": {
				"error_code": "INVALID_TARGET"
			},
			"params": {
				"actor": "ORDER_ACTOR",
				"destination": "TARGET_NODE"
			},
			"primitive": "MOVE_ACTOR",
			"step_id": "transit_premises"
		},
		{
			"next_step": "steal_from_premises",
			"on_failure": {
				"error_code": "INVALID_TARGET"
			},
			"params": {
				"actor": "ORDER_ACTOR",
				"domain": "LOCATION",
				"metric": "current_district_id",
				"operator": "==",
				"value": "TARGET_NODE"
			},
			"primitive": "REQUIRE",
			"step_id": "gate_premises_co_location"
		},
		{
			"next_step": null,
			"params": {
				"from": "PARAM.target_entity_id",
				"item_id": "PARAM.item_id",
				"quantity": "PARAM.amount",
				"to": "ORDER_ACTOR"
			},
			"primitive": "TRANSFER_ITEM",
			"step_id": "steal_from_premises"
		},
		{
			"params": {
				"actor": "ORDER_ACTOR",
				"domain": "LOCATION",
				"metric": "current_district_id",
				"operator": "==",
				"value": "TARGET_NODE"
			},
			"primitive": "REQUIRE",
			"step_id": "gate_presence"
		},
		{
			"params": {
				"from": "PARAM.counterparty_id",
				"item_id": "CASH",
				"quantity": "PARAM.amount",
				"to": "ORDER_ACTOR"
			},
			"primitive": "TRANSFER_ITEM",
			"step_id": "collect_debt_cash"
		}
	]
}
