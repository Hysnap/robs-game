{
  "_meta": {
    "verb_token": "INVESTIGATE",
    "version": 1,
    "flavour_overlay": "crime",
    "description": "Crime flavour overlay extending INVESTIGATE with STAKEOUT and CASE_JOINT surveillance branches."
  },
  "steps": [
    {
      "step_id": "branch_mode_dispatch",
      "on_false": "branch_crime_stakeout"
    },
    {
      "step_id": "branch_crime_stakeout",
      "primitive": "REQUIRE",
      "params": {
        "domain": "PARAM",
        "metric": "PARAM.mode",
        "operator": "==",
        "value": "STAKEOUT"
      },
      "on_true": "COMPLETE",
      "on_false": "branch_crime_case_joint"
    },
    {
      "step_id": "branch_crime_case_joint",
      "primitive": "REQUIRE",
      "params": {
        "domain": "PARAM",
        "metric": "PARAM.mode",
        "operator": "==",
        "value": "CASE_JOINT"
      },
      "on_failure": {
        "error_code": "INVALID_PARAMETER"
      },
      "on_true": "COMPLETE"
    }
  ]
}