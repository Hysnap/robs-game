{
  "_meta": {
    "era": "1980s",
    "region": "United Kingdom",
    "version": "1.5.0",
    "description": "Municipal clustering scales, public/banking holiday calendar, hierarchical public organizations with autonomy modes, physical wing sub-establishments, civic disbursement schedules, and postal delivery rules."
