{
  "_meta": {
    "version": "1.3.0",
    "scope": "IMPACT_METRIC_PROFILE",
    "description": "Spatial district residential household units and domestic dwelling count."
  },
  "metric_id": "HOUSEHOLDS",
  "label_token": "UI_METRIC_HOUSEHOLDS",
  "target_scope": "SPATIAL",
  "routing_mode": "DIRECT",
  "state_container": "districts",
  "state_field": "actual_households",
  "format": "INTEGER",
  "decimals": 0,
  "min_value": 0,
  "max_value": 2000000,
  "suffix": " households",
  "telemetry_source": {
    "type": "DATABASE_AGGREGATE",
    "table": "households",
    "aggregate": "COUNT(*)",
    "where": "district_id = '{id}'"
  },
  "tuning": {
    "default_baseline": 1800,
    "minimum_floor": 0,
    "maximum_ceiling": 2000000
  },
  "perception": {
    "STEPPED_ROUNDING":{
    "id": "headcount_stepped",
    "source_field": "total_households",
    "target_field": "total_households",
    "mode": "STEPPED_ROUNDING",
    "fuzz_jitter_min": -0.15,
    "fuzz_jitter_max": 0.15,
    "home_modifier": 0.10,
    "error_floor": 0.02,
    "default_step": 250,
    "fallback_token": null,
    "tiers": [
      { "threshold": 10, "round_to": 1 },
      { "threshold": 50, "round_to": 5 },
      { "threshold": 250, "round_to": 25 },
      { "threshold": 500, "round_to": 50 },
      { "threshold": 1500, "round_to": 100 },
      { "threshold": 5000, "round_to": 250 },
      { "threshold": 10000, "round_to": 500 },
      { "threshold": 999999, "round_to": 1000 }
    ]
  },
    "BUCKET_CHANNEL": {
      "id": "households_bucket",
      "source_field": "total_households",
      "target_field": "households_bucket_token",
      "mode": "N_BUCKET",
      "fuzz_jitter_min": -20.0,
      "fuzz_jitter_max": 20.0,
      "home_modifier": 5.0,
      "error_floor": 2.0,
      "fallback_token": "UI_INTEL_MASKED_BLANK",
      "buckets": [
        { "max": 150.0, "token": "UI_HH_DESOLATE" },
        { "max": 400.0, "token": "UI_HH_SPARSE" },
        { "max": 800.0, "token": "UI_HH_MODERATE" },
        { "max": 800.0, "token": "UI_HH_DENSE" },
        { "token": "UI_HH_SATURATED" }
      ]
    }
  }
}