{
  "_meta": {
    "version": "1.3.0",
    "scope": "IMPACT_METRIC_PROFILE",
    "description": "Active households across a spatial container or district"
  },
  "metric_id": "HOUSEHOLD",
  "label_token": "UI_METRIC_HOUSEHOLD",
  "format": "INT",
  "decimals": 0,
  "target_scope": "SPATIAL",
  "telemetry_source": {
    "type": "SQLITE_DYNAMIC",
    "query_field": "total_households"
  },
  "tuning": {
    "default_baseline_households": 0,
    "passive_growth_rate_per_tick": 0
  },
  "perception": {
    "target_field": "household_bucket_token",
    "mode": "N_BUCKET",
    "fuzz_jitter_min": -0.05,
    "fuzz_jitter_max": 0.05,
    "home_modifier": 0.02,
    "error_floor": 0.02,
    "fallback_token": "UI_INTEL_MASKED_BLANK",
    "buckets": [
      { "max": 150.0, "token": "UI_HH_DESOLATE" },
      { "max": 400.0, "token": "UI_HH_SPARSE" },
      { "max": 800.0, "token": "UI_HH_MODERATE" },
      { "max": 800.0, "token": "UI_HH_DENSE" },
      { "token": "UI_HH_SATURATED" }
    ]
  }
}