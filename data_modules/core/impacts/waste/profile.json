{
  "_meta": {
    "version": "1.3.0",
    "scope": "IMPACT_METRIC_PROFILE",
    "description": "Accumulated physical operational scrap, workshop trimmings, and byproduct waste."
  },
  "metric_id": "MATERIAL_WASTE",
  "label_token": "UI_METRIC_MATERIAL_WASTE",
  "target_scope": "GLOBAL",
  "routing_mode": "DIRECT",
  "state_container": "operations",
  "state_field": "material_waste_accumulated",
  "format": "FLOAT",
  "decimals": 1,
  "min_value": 0.0,
  "max_value": 1000.0,
  "suffix": "kg",
  "telemetry_source": {
    "type": "WORLD_STATE",
    "state_path": "operations.material_waste_accumulated"
  },
  "tuning": {
    "default_baseline": 0.0,
    "passive_cleaning_per_week": 2.0,
    "minimum_floor": 0.0,
    "maximum_ceiling": 1000.0
  },
  "perception": {
    "id": "waste_bucket",
    "source_field": "material_waste_accumulated",
    "target_field": "waste_bucket_token",
    "mode": "STEPPED_ROUNDING",
    "default_step": 1,
    "fallback_token": "UI_INTEL_MASKED_BLANK",
    "tiers": [
      { "threshold": 10, "round_to": 1 },
      { "threshold": 50, "round_to": 5 },
      { "threshold": 100, "round_to": 10 },
      { "threshold": 500, "round_to": 25 }
    ]
  }
}