{
  "_meta": {
    "version": "1.3.0",
    "scope": "IMPACT_METRIC_PROFILE",
    "description": "Internal theft, embezzlement, and inventory skimming by disloyal staff operatives."
  },
  "metric_id": "STAFF_SKIM",
  "label_token": "UI_METRIC_STAFF_SKIM",
  "target_scope": "ACTOR",
  "routing_mode": "ACTOR_FALLBACK",
  "state_container": "staff",
  "state_field": "actual_skim",
  "format": "PERCENT",
  "decimals": 1,
  "min_value": 0.0,
  "max_value": 1.0,
  "suffix": "%",
  "telemetry_source": {
    "type": "WORLD_STATE",
    "state_path": "staff.{id}.actual_skim"
  },
  "tuning": {
    "minimum_floor": 0.0,
    "maximum_ceiling": 1.0,
    "loyalty_field": "loyalty",
    "loyalty_skim_threshold": 0.60,
    "loyalty_operator": "<",
    "ambient_skim_increment": 0.01,
    "max_ambient_skim": 0.25
  },
  "perception": {
    "bucket_channel": {
      "id": "skim_bucket",
      "source_field": "actual_skim",
      "target_field": "skim_bucket_token",
      "mode": "N_BUCKET",
      "fuzz_jitter_min": -0.02,
      "fuzz_jitter_max": 0.02,
      "home_modifier": 0.01,
      "error_floor": 0.005,
      "fallback_token": "UI_INTEL_MASKED_BLANK",
      "buckets": [
        { "max": 0.02, "token": "UI_SKIM_NEGLIGIBLE" },
        { "max": 0.08, "token": "UI_SKIM_SUSPECTED" },
        { "max": 0.15, "token": "UI_SKIM_RAMPANT" },
        { "token": "UI_SKIM_HEMORRHAGING" }
      ]
    }
  }
}