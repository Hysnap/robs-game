  },
  "perception": {
    "target_field": "perceived_staff_skim",
    "mode": "N_BUCKET",
    "fuzz_jitter_min": -0.08,
    "fuzz_jitter_max": 0.08,
    "home_modifier": 0.04,
    "error_floor": 0.02,
    "fallback_token": "UI_INTEL_MASKED_BLANK",
    "buckets": [
      { "max": 0.05, "token": "UI_SKIM_HONEST" },
      { "max": 0.15, "token": "UI_SKIM_MINOR_LEAK" },
      { "max": 0.30, "token": "UI_SKIM_SUBSTANTIAL" },
      { "token": "UI_SKIM_FLAGRANT" }
    ]
  }
}