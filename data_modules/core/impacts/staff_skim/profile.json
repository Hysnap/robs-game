{
  "_meta": {
    "version": "1.2.0",
    "scope": "IMPACT_METRIC_PROFILE",
    "description": "Opportunistic cash or inventory diversion rate by assigned operative or counterparty"
  },
  "metric_id": "STAFF_SKIM",
  "label_token": "UI_METRIC_STAFF_SKIM",
  "format": "PERCENT",
