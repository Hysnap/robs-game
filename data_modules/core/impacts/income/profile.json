{
  "_meta": {
    "version": "1.3.0",
    "scope": "IMPACT_METRIC_PROFILE",
    "description": "Gross total income across formal wages, state benefits, pensions, and informal streams"
  },
  "metric_id": "INCOME",
  "label_token": "UI_METRIC_INCOME",
  "format": "CURRENCY",
  "decimals": 2,
  "telemetry_source": {
    "type": "SQLITE_DYNAMIC",
    "query_field": "total_income"
  },
  "tuning": {
    "default_baseline_income": 30.0,
    "default_channel": "GENERAL_MODIFIER"
  },
  "perception": {
    "target_field": "income_bucket_token",
    "mode": "N_BUCKET",
    "fuzz_jitter_min": -0.10,
    "fuzz_jitter_max": 0.10,
    "home_modifier": 0.05,
    "error_floor": 0.02,
    "fallback_token": "UI_INTEL_MASKED_BLANK",
    "buckets": [
      { "max": 40.0, "token": "UI_INCOME_DESTITUTE" },
      { "max": 80.0, "token": "UI_INCOME_LOW" },
      { "max": 160.0, "token": "UI_INCOME_MODERATE" },
      { "max": 280.0, "token": "UI_INCOME_COMFORTABLE" },
      { "token": "UI_INCOME_HIGH" }
    ]
  }
}