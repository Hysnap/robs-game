{
  "_meta": {
    "version": "1.3.0",
    "scope": "IMPACT_METRIC_PROFILE",
    "description": "Spatial district citizen earned wage level and median household income telemetry."
  },
  "metric_id": "INCOME",
  "label_token": "UI_METRIC_INCOME",
  "target_scope": "SPATIAL",
  "routing_mode": "DIRECT",
  "state_container": "districts",
  "state_field": "actual_median_income",
  "format": "CURRENCY",
  "decimals": 0,
  "min_value": 0.0,
  "max_value": 100000.0,
  "telemetry_source": {
    "type": "DATABASE_AGGREGATE",
    "table": "citizens",
    "aggregate": "COALESCE(AVG(wage_income), 0.0)",
    "where": "district_id = '{id}' AND employment_status = 'EMPLOYED'"
  },
  "tuning": {
    "default_baseline": 4500.0,
    "passive_drift_per_tick": 5.0,
    "minimum_floor": 0.0,
    "maximum_ceiling": 100000.0
  },
  "perception": {"bucket_channel": {
      "id": "income_bucket",
      "source_field": "actual_median_income",
      "target_field": "income_bucket_token",
      "mode": "N_BUCKET",
      "fuzz_jitter_min": -15.0,
      "fuzz_jitter_max": 15.0,
      "home_modifier": 5.0,
      "error_floor": 7.0,
      "fallback_token": "UI_INTEL_MASKED_BLANK",
      "buckets": [
        { "max": 40.0, "token": "UI_INCOME_DESTITUTE" },
        { "max": 80.0, "token": "UI_INCOME_LOW" },
        { "max": 160.0, "token": "UI_INCOME_MODERATE" },
        { "max": 280.0, "token": "UI_INCOME_COMFORTABLE" },
        { "token": "UI_INCOME_HIGH" }
      ]
    }
  }
}