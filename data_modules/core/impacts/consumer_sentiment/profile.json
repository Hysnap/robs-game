{
  "_meta": {
    "version": "1.3.0",
    "scope": "IMPACT_METRIC_PROFILE",
    "description": "Spatial district consumer confidence, market optimism, and willingness to spend."
  },
  "metric_id": "CONSUMER_SENTIMENT",
  "metric_class": "BIPOLAR_IMPACT",
  "label_token": "UI_METRIC_CONSUMER_SENTIMENT",
  "target_scope": "SPATIAL",
  "routing_mode": "DIRECT",
  "state_container": "districts",
  "state_field": "consumer_sentiment",
  "format": "FLOAT",
  "decimals": 2,
  "min_value": -100.0,
  "max_value": 100.0,
  "telemetry_source": {
    "type": "WORLD_STATE",
    "state_path": "districts.consumer_sentiment"
  },
  "tuning": {
    "default_baseline_sentiment": 0.0,
    "passive_drift_per_tick": 2,
    "minimum_floor": -100.0,
    "maximum_ceiling": 100.0
  },
  "perception": {
    "bucket_channel": {
      "id": "sentiment_bucket",
      "source_field": "consumer_sentiment",
      "target_field": "sentiment_bucket_token",
      "mode": "N_BUCKET",
      "fuzz_jitter_min": -5,
      "fuzz_jitter_max": 5,
      "home_modifier": 2,
      "error_floor": 1,
      "fallback_token": "UI_INTEL_MASKED_BLANK",
      "buckets": [
        { "max": 25, "token": "UI_SENTIMENT_DESPERATE" },
        { "max": 45, "token": "UI_SENTIMENT_DISSATISFIED" },
        { "max": 75, "token": "UI_SENTIMENT_CONTENT" },
        { "token": "UI_SENTIMENT_ELATED" }
      ]
    }
  }
}