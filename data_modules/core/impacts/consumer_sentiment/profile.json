{
  "_meta": {
    "version": "1.3.0",
    "scope": "IMPACT_METRIC_PROFILE",
    "description": "District-level consumer confidence, spending buoyancy, and price tolerance versus economic distress"
  },
  "metric_id": "CONSUMER_SENTIMENT",
  "label_token": "UI_METRIC_CONSUMER_SENTIMENT",
  "format": "FLOAT",
  "decimals": 2,
  "telemetry_source": {
    "type": "WORLD_STATE",
    "state_path": "consumer_sentiment"
  },
  "tuning": {
    "default_baseline_sentiment": 1.0,
    "passive_drift_per_tick": 0.02
  },
  "perception": {
    "target_field": "sentiment_bucket_token",
    "mode": "N_BUCKET",
    "fuzz_jitter_min": -0.10,
    "fuzz_jitter_max": 0.10,
    "home_modifier": 0.05,
    "error_floor": 0.02,
    "fallback_token": "UI_INTEL_MASKED_BLANK",
    "buckets": [
      { "max": 0.35, "token": "UI_SENTIMENT_DESPERATE" },
      { "max": 0.70, "token": "UI_SENTIMENT_PESSIMISTIC" },
      { "max": 1.15, "token": "UI_SENTIMENT_NEUTRAL" },
      { "max": 1.60, "token": "UI_SENTIMENT_CONFIDENT" },
      { "token": "UI_SENTIMENT_BUOYANT" }
    ]
  }
}