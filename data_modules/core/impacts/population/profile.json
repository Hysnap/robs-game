{
  "_meta": {
    "version": "1.3.0",
    "scope": "IMPACT_METRIC_PROFILE",
    "description": "Spatial district resident headcount and census telemetry."
  },
  "metric_id": "POPULATION",
  "label_token": "UI_METRIC_POPULATION",
  "target_scope": "SPATIAL",
  "routing_mode": "DIRECT",
  "state_container": "districts",
  "state_field": "actual_population",
  "format": "INTEGER",
  "decimals": 0,
  "min_value": 0,
  "max_value": 1000000,
  "suffix": " citizens",
  "telemetry_source": {
    "type": "DATABASE_AGGREGATE",
    "table": "citizens",
    "aggregate": "COUNT(*)",
    "where": "district_id = '{id}'"
  },
  "tuning": {
    "default_baseline": 5000,
    "minimum_floor": 0,
    "maximum_ceiling": 1000000
  },
  "perception": {
    "STEPPED_ROUNDING":{
    "id": "population_stepped",
    "source_field": "active_population",
    "target_field": "active_population",
    "mode": "STEPPED_ROUNDING",
    "fuzz_jitter_min": -0.15,
    "fuzz_jitter_max": 0.15,
    "home_modifier": 0.10,
    "error_floor": 0.02,
    "default_step": 250,
    "fallback_token": null,
    "tiers": [
      { "threshold": 10, "round_to": 1 },
      { "threshold": 50, "round_to": 5 },
      { "threshold": 250, "round_to": 25 },
      { "threshold": 500, "round_to": 50 },
      { "threshold": 1500, "round_to": 100 },
      { "threshold": 5000, "round_to": 250 },
      { "threshold": 10000, "round_to": 500 },
      { "threshold": 999999, "round_to": 1000 }
    ]
  },
  "BUCKET_CHANNEL":{
    "id": "population_bucket",
    "source_field": "total_population",
    "target_field": "population_bucket_token",
    "mode": "N_BUCKET",
    "fuzz_jitter_min": -50.0,
    "fuzz_jitter_max": 50.0,
    "home_modifier": 10.0,
    "error_floor": 5.0,
    "fallback_token": "UI_INTEL_MASKED_BLANK",
    "buckets": [
      { "max": 150.0, "token": "UI_POP_SPARSE" },
      { "max": 400.0, "token": "UI_POP_MODERATE" },
      { "max": 800.0, "token": "UI_POP_DENSE" },
      { "token": "UI_POP_TEEMING" }
    ]
  }
  }
}