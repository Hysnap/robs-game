{
  "_meta": {
    "version": "1.3.0",
    "scope": "IMPACT_METRIC_PROFILE",
    "description": "Active contracted workforce staffing headcount at an individual establishment"
  },
  "metric_id": "ESTABLISHMENT_HEADCOUNT",
  "label_token": "UI_LBL_WORKFORCE_COUNT",
  "format": "INTEGER",
  "decimals": 0,
  "telemetry_source": {
    "type": "SQLITE_DYNAMIC",
    "query_field": "active_workforce_count"
  },
  "tuning": {
    "default_baseline_headcount": 0,
    "allow_overstaffing": false
  },
  "perception": {
    "target_field": "worker_count",
    "mode": "STEPPED_ROUNDING",
    "default_step": 1,
    "fallback_token": "UI_INTEL_MASKED_BLANK",
    "tiers": [
      { "threshold": 10, "round_to": 1 },
      { "threshold": 50, "round_to": 5 },
      { "threshold": 250, "round_to": 25 },
      { "threshold": 1000, "round_to": 100 }
    ]
  }
}