{
  "_meta": {
    "version": "1.3.0",
    "scope": "IMPACT_METRIC_PROFILE",
    "description": "Civic and institutional tolerance for bribery, graft, and informal arrangements within a district"
  },
  "metric_id": "CORRUPTION_TOLERANCE",
  "metric_class": "BIPOLAR_IMPACT",
  "label_token": "UI_METRIC_CORRUPTION_TOLERANCE",
  "format": "FLOAT",
  "decimals": 2,
  "min_value": -100.0,
  "max_value": 100.0,
  "telemetry_source": {
    "type": "WORLD_STATE",
    "state_path": "corruption_tolerance"
  },
  "tuning": {
    "default_baseline_tolerance": 0.0,
    "passive_drift_per_tick": 1.0
  },
  "perception": {
    "target_field": "corruption_bucket_token",
    "mode": "N_BUCKET",
    "fuzz_jitter_min": -10,
    "fuzz_jitter_max": 10,
    "home_modifier": 5,
    "error_floor": 2,
    "fallback_token": "UI_INTEL_MASKED_BLANK",
    "buckets": [
      { "max": 15, "token": "UI_CORRUPT_INTOLERANT" },
      { "max": 35, "token": "UI_CORRUPT_RESISTANT" },
      { "max": 60, "token": "UI_CORRUPT_FLEXIBLE" },
      { "max": 80, "token": "UI_CORRUPT_PERMISSIVE" },
      { "token": "UI_CORRUPT_ENTRENCHED" }
    ]
  }
}