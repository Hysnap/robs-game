{
  "_meta": {
    "version": "1.1.0",
    "scope": "IMPACT_METRIC_PROFILE"
  },
  "metric_id": "WORKER_FATIGUE",
  "label_token": "UI_METRIC_WORKER_FATIGUE",
  "format": "FLOAT",
  "decimals": 1,
  "telemetry_source": {
    "type": "WORLD_STATE",
    "state_path": "operations.fatigue"
  },
  "perception": {
