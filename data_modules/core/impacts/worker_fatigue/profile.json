    "home_modifier": 0.05,
    "error_floor": 0.02,
    "fallback_token": "UI_INTEL_MASKED_BLANK",
    "buckets": [
      { "max": 15, "token": "UI_WORKER_FATIGUE_COLD" },
      { "max": 35, "token": "UI_WORKER_FATIGUE_NORMAL" },
      { "max": 60, "token": "UI_WORKER_FATIGUE_HEIGHTENED" },
      { "max": 80, "token": "UI_WORKER_FATIGUE_ACUTE" },
      { "token": "UI_WORKER_FATIGUE_CRITICAL" }
    ]
  }
}