{
  "_meta": {
    "version": "1.3.0",
    "scope": "IMPACT_METRIC_PROFILE",
    "description": "Physical warehouse footprint, backroom stockpile volume, and container capacity utilization."
  },
  "metric_id": "MATERIAL_STORAGE",
  "label_token": "UI_METRIC_MATERIAL_STORAGE",
  "target_scope": "ACTOR",
  "routing_mode": "ACTOR_FALLBACK",
  "state_container": "operations",
  "state_field": "material_storage_accumulated",
  "format": "FLOAT",
  "decimals": 1,
  "min_value": 0.0,
  "max_value": 5000.0,
  "suffix": "m³",
  "telemetry_source": {
    "type": "WORLD_STATE",
    "state_path": "operations.material_storage_accumulated"
  },
  "tuning": {
    "default_baseline": 0.0,
    "minimum_floor": 0.0,
    "maximum_ceiling": 5000.0
  },
  "perception": {
	"id": "storage_bucket",
  "source_field": "material_storage_accumulated",
  "target_field": "storage_bucket_token",
	"mode": "STEPPED_ROUNDING",
	"default_step": 1,
	"fallback_token": "UI_INTEL_MASKED_BLANK",
	"tiers": [
	  { "threshold": 1000, "round_to": 1 }
	]
  }
}
