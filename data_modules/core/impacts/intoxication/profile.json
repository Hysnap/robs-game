{
  "_meta": {
    "version": "1.3.0",
    "scope": "IMPACT_METRIC_PROFILE",
    "description": "Acute physiological impairment and motor/cognitive intoxication level"
  },
  "metric_id": "INTOXICATION",
  "metric_class": "SEVERITY_IMPACT",
  "label_token": "UI_METRIC_INTOXICATION",
  "target_scope": "RESIDENT",
  "routing_mode": "DIRECT",
  "state_container": "residents",
  "state_field": "intoxication",
  "format": "PERCENT",
  "decimals": 0,
  "min_value": 0.0,
  "max_value": 100.0,
  "suffix": "%",
  "telemetry_source": {
    "type": "ACTOR_STATE",
    "state_path": "residents.{id}.intoxication"
  },
  "perception": {
    "target_field": "perceived_intoxication",
    "mode": "N_BUCKET",
    "fuzz_jitter_min": -0.05,
    "fuzz_jitter_max": 0.05,
    "home_modifier": 0.02,
    "error_floor": 0.01,
    "fallback_token": "UI_INTEL_MASKED_BLANK",
    "buckets": [
      { "max": 10.0, "token": "UI_INTOX_SOBER" },
      { "max": 35.0, "token": "UI_INTOX_TIPSY" },
      { "max": 70.0, "token": "UI_INTOX_INEBRIATED" },
      { "token": "UI_INTOX_INCAPACITATED" }
    ]
  }
}