{
  "_meta": {
    "version": "1.3.0",
    "scope": "IMPACT_METRIC_PROFILE",
    "description": "Spatial precinct law enforcement vigilance, surveillance, and interdiction intensity."
  },
  "metric_id": "POLICE_HEAT",
  "label_token": "UI_METRIC_POLICE_HEAT",
  "target_scope": "SPATIAL",
  "routing_mode": "DIRECT",
  "state_container": "districts",
  "state_field": "actual_police_heat",
  "format": "PERCENT",
  "decimals": 1,
  "min_value": 0.0,
  "max_value": 1.0,
  "suffix": "%",
  "telemetry_source": {
    "type": "WORLD_STATE",
    "state_path": "districts.actual_police_heat"
  },
  "tuning": {
    "default_baseline_heat": 0.0,
    "passive_cooling_per_week": 0.05,
    "minimum_floor": 0.0,
    "maximum_ceiling": 1.0
  },
  "perception": {
    "bucket_channel": {
      "id": "heat_bucket",
      "source_field": "actual_police_heat",
      "target_field": "heat_bucket_token",
      "mode": "N_BUCKET",
      "fuzz_jitter_min": -0.05,
      "fuzz_jitter_max": 0.05,
      "home_modifier": 0.02,
      "error_floor": 0.01,
      "fallback_token": "UI_INTEL_MASKED_BLANK",
      "buckets": [
        { "max": 0.15, "token": "UI_HEAT_COLD" },
        { "max": 0.35, "token": "UI_HEAT_NORMAL" },
        { "max": 0.60, "token": "UI_HEAT_HEIGHTENED" },
        { "max": 0.85, "token": "UI_HEAT_ACUTE" },
        { "token": "UI_HEAT_CRITICAL" }
      ]
    }
  }
}