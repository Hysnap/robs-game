{
  "_meta": {
    "version": "1.3.0",
    "scope": "IMPACT_METRIC_PROFILE",
    "description": "Operational labor time logged by staff operatives or the central player enterprise per cycle."
  },
  "metric_id": "OPERATIONAL_TIME",
  "label_token": "UI_METRIC_OPERATIONAL_TIME",
  "target_scope": "ACTOR",
  "routing_mode": "ACTOR_FALLBACK",
  "state_container": "staff",
  "state_field": "shift_time_spent",
  "format": "FLOAT",
  "decimals": 1,
  "min_value": 0.0,
  "max_value": 168.0,
  "suffix": "h",
  "telemetry_source": {
    "type": "WORLD_STATE",
    "state_path": "staff.{id}.shift_time_spent"
  },
  "tuning": {
    "default_baseline": 0.0,
    "reset_on_cycle": true,
    "minimum_floor": 0.0,
    "maximum_ceiling": 168.0
  },
  "perception": {
    "id": "time_spent_bucket",
    "source_field": "shift_time_spent",
    "target_field": "time_spent_bucket_token",
    "mode": "STEPPED_ROUNDING",
    "default_step": 1,
    "fallback_token": "UI_INTEL_MASKED_BLANK",
    "tiers": [
      { "threshold": 720, "round_to": 1 }
    ]
  }
}