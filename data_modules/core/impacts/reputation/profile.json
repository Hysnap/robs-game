{
  "_meta": {
    "version": "1.3.0",
    "scope": "IMPACT_METRIC_PROFILE",
    "description": "Pairwise reverence and public esteem across actors, organizations, and spatial districts, with RESIDENT -> ORG -> GLOBAL inheritance."
  },
  "metric_id": "REPUTATION",
  "metric_class": "BIPOLAR_IMPACT",
  "label_token": "UI_METRIC_REPUTATION",
  "target_scope": "STANDINGS",
  "routing_mode": "DIRECT",
  "state_container": "standings",
  "state_field": "reputation",
  "inheritance_chain": ["RESIDENT", "ORG", "GLOBAL"],
  "format": "SIGNED_FLOAT",
  "decimals": 2,
  "min_value": -100.0,
  "max_value": 100.0,
  "telemetry_source": {
    "type": "WORLD_STATE",
    "state_path": "standings.{observer_scope}.{observer_id}.{target_key}.reputation"
  },
  "tuning": {
    "default_baseline_reputation": 0.0,
    "passive_decay_rate_per_tick": 2,
    "minimum_floor": -100.0,
    "maximum_ceiling": 100.0
  },
  "perception": {
    "bucket_channel": {
      "id": "reputation_bucket",
      "source_field": "reputation",
      "target_field": "reputation_bucket_token",
      "mode": "N_BUCKET",
      "fuzz_jitter_min": -0.05,
      "fuzz_jitter_max": 0.05,
      "home_modifier": 0.02,
      "error_floor": 0.01,
      "fallback_token": "UI_INTEL_MASKED_BLANK",
      "buckets": [
        { "max": -60, "token": "UI_REP_LOATHED" },
        { "max": -20, "token": "UI_REP_DISTORIOUS" },
        { "max": 20, "token": "UI_REP_NEUTRAL" },
        { "max": 60, "token": "UI_REP_FAVORED" },
        { "token": "UI_REP_REVERED" }
      ]
    }
  }
}