{
  "_meta": {
    "verb_token": "COMMUNICATE",
    "version": 2,
    "user_creatable": true,
    "description": "Direct interpersonal conversation and intelligence exchange between co-located residents"
  },
  "parameters": {
    "target_resident_id": { "type": "STRING", "required": true },
    "target_node_id": { "type": "STRING", "required": true },
    "duration_ticks": { "type": "FLOAT", "default": 1.0 }
  },
  "steps": [
    {
      "step_id": "gate_operative_presence",
      "primitive": "REQUIRE",
      "params": {
        "domain": "LOCATION",
        "actor": "ORDER_ACTOR",
        "metric": "current_district_id",
        "operator": "==",
        "value": "TARGET_NODE"
      },
      "on_failure": {
        "error_code": "INVALID_TARGET"
      },
      "next_step": "gate_target_resident_presence"
    },
    {
      "step_id": "gate_target_resident_presence",
      "primitive": "REQUIRE",
      "params": {
        "domain": "LOCATION",
        "actor": "PARAM.target_resident_id",
        "metric": "current_district_id",
        "operator": "==",
        "value": "TARGET_NODE"
      },
      "on_failure": {
        "error_code": "INVALID_TARGET"
      },
      "next_step": null
    }
  ]
}