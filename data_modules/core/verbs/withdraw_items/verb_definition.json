{
  "_meta": {
    "verb_token": "WITHDRAW_ITEMS",
    "version": 2,
    "user_creatable": true,
    "description": "Withdraw cash or commodities from an establishment storage pool into operative custody"
  },
  "parameters": {
    "establishment_id": { "type": "STRING", "required": true },
    "item_id": { "type": "STRING", "required": true },
    "amount": { "type": "FLOAT", "default": 1.0 },
    "target_node_id": { "type": "STRING", "required": true }
  },
  "steps": [
    {
      "step_id": "gate_establishment_stock",
      "primitive": "REQUIRE",
      "params": {
        "domain": "COMMODITY",
        "actor": "PARAM.establishment_id",
        "metric": "PARAM.item_id",
        "operator": ">=",
        "value": "PARAM.amount"
      },
      "on_failure": {
        "error_code": "INSUFFICIENT_RESOURCE"
      },
      "next_step": "gate_co_location"
    },
    {
      "step_id": "gate_co_location",
      "primitive": "REQUIRE",
      "params": {
        "domain": "LOCATION",
        "actor": "ORDER_ACTOR",
        "metric": "current_district_id",
        "operator": "==",
        "value": "TARGET_NODE"
      },
      "on_failure": {
        "error_code": "INVALID_TARGET"
      },
      "next_step": "withdraw_stock"
    },
    {
      "step_id": "withdraw_stock",
      "primitive": "TRANSFER_ITEM",
      "params": {
        "from": "PARAM.establishment_id",
        "to": "ORDER_ACTOR",
        "item_id": "PARAM.item_id",
        "quantity": "PARAM.amount"
      },
      "next_step": null
    }
  ]
}