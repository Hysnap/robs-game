{
  "_meta": {
    "verb_token": "BUY",
    "version": 1,
    "user_creatable": true,
    "description": "Commercial wholesale or retail purchase"
  },
  "parameters": {
    "item_id": { "type": "STRING", "required": true },
    "amount": { "type": "FLOAT", "default": 1.0 },
    "unit_cost": { "type": "FLOAT", "required": true },
    "target_node_id": { "type": "STRING", "required": true },
    "supplier_id": { "type": "STRING", "required": true }
  },
  "steps": [
    {
      "step_id": "gate_cash",
      "primitive": "REQUIRE",
      "params": {
        "domain": "COMMODITY",
        "actor": "ORDER_ACTOR",
        "metric": "CASH",
        "operator": ">=",
        "value": "CALCULATED_TOTAL_COST"
      },
      "on_failure": {
        "error_code": "INSUFFICIENT_FUNDS"
      },
      "next_step": "transit"
    },
    {
      "step_id": "transit",
      "primitive": "MOVE_ACTOR",
      "params": {
        "actor": "ORDER_ACTOR",
        "destination": "PARAM.target_node_id",
        "travel_time": 20.0,
        "travel_fatigue": 0.04
      },
      "on_failure": {
        "error_code": "ROUTE_UNREACHABLE"
      },
      "next_step": "verify_stock"
    },
    {
      "step_id": "verify_stock",
      "primitive": "REQUIRE",
      "params": {
        "domain": "COMMODITY",
        "actor": "PARAM.supplier_id",
        "metric": "PARAM.item_id",
        "operator": ">=",
        "value": "PARAM.amount"
      },
      "on_failure": {
        "error_code": "OUT_OF_STOCK",
        "penalties": {
          "extra_time_spent": 15.0,
          "extra_fatigue": 0.02
        }
      },
      "next_step": "pay_supplier"
    },
    {
      "step_id": "pay_supplier",
      "primitive": "TRANSFER_ITEM",
      "params": {
        "from": "ORDER_ACTOR",
        "to": "PARAM.supplier_id",
        "item_id": "CASH",
        "quantity": "CALCULATED_TOTAL_COST",
        "transfer_time": 5.0,
        "transfer_fatigue": 0.01
      },
      "next_step": "receive_stock"
    },
    {
      "step_id": "receive_stock",
      "primitive": "TRANSFER_ITEM",
      "params": {
        "from": "PARAM.supplier_id",
        "to": "ORDER_ACTOR",
        "item_id": "PARAM.item_id",
        "quantity": "PARAM.amount",
        "transfer_time": 10.0,
        "transfer_fatigue": 0.02
      },
      "next_step": "trigger_macro_impacts"
    },
    {
      "step_id": "trigger_macro_impacts",
      "primitive": "DISPATCH_IMPACT",
      "params": {
        "load_from_folder": "res://data_modules/core/verbs/buy/impacts/"
      },
      "next_step": null
    }
  ]
}