{
  "_meta": {
    "verb_token": "TRAVEL",
    "version": 2,
    "user_creatable": true,
    "description": "Spatial transit of an operative between districts"
  },
  "parameters": {
    "destination_district_id": { "type": "STRING", "required": true },
    "target_node_id": { "type": "STRING", "required": false }
  },
  "steps": [
    {
      "step_id": "gate_not_already_at_dest",
      "primitive": "REQUIRE",
      "params": {
        "domain": "LOCATION",
        "actor": "ORDER_ACTOR",
        "metric": "current_district_id",
        "operator": "!=",
        "value": "PARAM.destination_district_id"
      },
      "on_failure": {
        "error_code": "INVALID_PARAMETER"
      },
      "next_step": "transit"
    },
    {
      "step_id": "transit",
      "primitive": "MOVE_ACTOR",
      "params": {
        "actor": "ORDER_ACTOR",
        "destination": "PARAM.destination_district_id"
      },
      "next_step": null
    }
  ]
}