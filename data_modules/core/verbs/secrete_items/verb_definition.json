{
  "_meta": {
    "verb_token": "SECRETE_ITEMS",
    "version": 2,
    "user_creatable": true,
    "description": "Stash cash or commodities from operative inventory into a field cache or dead-drop"
  },
  "parameters": {
    "cache_id": { "type": "STRING", "required": true },
    "item_id": { "type": "STRING", "required": true },
    "amount": { "type": "FLOAT", "default": 1.0 },
    "target_node_id": { "type": "STRING", "required": true }
  },
  "steps": [
    {
      "step_id": "gate_operative_stock",
      "primitive": "REQUIRE",
      "params": {
        "domain": "COMMODITY",
        "actor": "ORDER_ACTOR",
        "metric": "PARAM.item_id",
        "operator": ">=",
        "value": "PARAM.amount"
      },
      "on_failure": {
        "error_code": "INSUFFICIENT_RESOURCE"
      },
      "next_step": "gate_co_location"
    },
    {
      "step_id": "gate_co_location",
      "primitive": "REQUIRE",
      "params": {
        "domain": "LOCATION",
        "actor": "ORDER_ACTOR",
        "metric": "current_district_id",
        "operator": "==",
        "value": "TARGET_NODE"
      },
      "on_failure": {
        "error_code": "INVALID_TARGET"
      },
      "next_step": "stash_items"
    },
    {
      "step_id": "stash_items",
      "primitive": "TRANSFER_ITEM",
      "params": {
        "from": "ORDER_ACTOR",
        "to": "PARAM.cache_id",
        "item_id": "PARAM.item_id",
        "quantity": "PARAM.amount"
      },
      "next_step": null
    }
  ]
}