{
  "_meta": {
    "verb_token": "INVESTIGATE",
    "version": 3,
    "user_creatable": true,
    "description": "Focused reconnaissance and surveillance against a specific establishment or resident, extensible via flavour mode overlays."
  },
  "parameters": {
    "target_entity_id": { "type": "STRING", "required": false },
    "counterparty_id": { "type": "STRING", "required": false },
    "target_node_id": { "type": "STRING", "required": true },
    "mode": { "type": "STRING", "required": false, "default": "CASUAL_PROBE" },
    "amount": { "type": "FLOAT", "default": 2.0 },
    "duration_ticks": { "type": "FLOAT", "default": 2.0 }
  },
  "steps": [
    {
      "step_id": "gate_co_location",
      "primitive": "REQUIRE",
      "params": {
        "domain": "LOCATION",
        "actor": "ORDER_ACTOR",
        "metric": "current_district_id",
        "operator": "==",
        "value": "TARGET_NODE"
      },
      "on_failure": {
        "error_code": "INVALID_TARGET"
      },
      "next_step": "branch_mode_dispatch"
    },
    {
      "step_id": "branch_mode_dispatch",
      "primitive": "REQUIRE",
      "params": {
        "domain": "PARAM",
        "metric": "PARAM.mode",
        "operator": "==",
        "value": "CASUAL_PROBE"
      },
      "on_true": "COMPLETE",
      "on_false": "COMPLETE"
    }
  ]
}