{
  "_meta": {
    "verb_token": "DUMP",
    "version": 2,
    "user_creatable": true,
    "description": "Discard or dump physical commodities or cash from inventory"
  },
  "parameters": {
    "item_id": { "type": "STRING", "required": true },
    "amount": { "type": "FLOAT", "default": 1.0 }
  },
  "steps": [
    {
      "step_id": "gate_stock",
      "primitive": "REQUIRE",
      "params": {
        "domain": "COMMODITY",
        "actor": "ORDER_ACTOR",
        "metric": "PARAM.item_id",
        "operator": ">=",
        "value": "PARAM.amount"
      },
      "on_failure": {
        "error_code": "INSUFFICIENT_RESOURCE"
      },
      "next_step": "dump_stock"
    },
    {
      "step_id": "dump_stock",
      "primitive": "DEDUCT_ITEM",
      "params": {
        "from": "ORDER_ACTOR",
        "item_id": "PARAM.item_id",
        "quantity": "PARAM.amount"
      },
      "next_step": null
    }
  ]
}