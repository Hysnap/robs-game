{
  "_meta": {
    "verb_token": "SETTLE_OBLIGATION",
    "version": 2,
    "user_creatable": true,
    "description": "Settle or reduce an active financial, service, or commodity obligation with a co-located creditor."
  },
  "parameters": {
    "obligation_id": {
      "type": "INT",
      "required": true
    },
    "counterparty_id": {
      "type": "STRING",
      "required": true
    },
    "item_id": {
      "type": "STRING",
      "required": true
    },
    "amount": {
      "type": "FLOAT",
      "required": true
    },
    "target_node_id": {
      "type": "STRING",
      "required": true
    },
    "rail_code": {
      "type": "STRING",
      "required": false
    }
  },
  "steps": [
    {
      "step_id": "gate_payer_resource",
      "primitive": "REQUIRE",
      "params": {
        "domain": "COMMODITY",
        "actor": "ORDER_ACTOR",
        "metric": "PARAM.item_id",
        "operator": ">=",
        "value": "PARAM.amount"
      },
      "on_failure": {
        "error_code": "INSUFFICIENT_RESOURCE"
      },
      "next_step": "gate_co_location"
    },
    {
      "step_id": "gate_co_location",
      "primitive": "REQUIRE",
      "params": {
        "domain": "LOCATION",
        "actor": "ORDER_ACTOR",
        "metric": "current_district_id",
        "operator": "==",
        "value": "TARGET_NODE"
      },
      "on_failure": {
        "error_code": "INVALID_TARGET"
      },
      "next_step": "remit_settlement"
    },
    {
      "step_id": "remit_settlement",
      "primitive": "TRANSFER_ITEM",
      "params": {
        "from": "ORDER_ACTOR",
        "to": "PARAM.counterparty_id",
        "item_id": "PARAM.item_id",
        "quantity": "PARAM.amount"
      },
      "next_step": null
    }
  ]
}