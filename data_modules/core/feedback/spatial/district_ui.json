{
  "_meta": {
    "schema_version": "2.0.0",
    "locale": "en_GB",
    "scope": "SPATIAL_DISTRICT_FEEDBACK",
    "description": "Unified schema for district HUD tooltips, dynamic Filofax dockets, and scouting telemetry"
  },
  "metric_labels": {
    "active_population": "Total Residents",
    "total_households": "Registered Households",
    "unemployment_rate": "Unemployment Ratio",
    "avg_disposable_income": "Mean Disposable Income"
  },

  "currency_format": "£{amount}/wk",
  "ratio_format": "{percent}%",
  "docket_audit_stale_warning": "[!] Stale Intelligence: Last audited {weeks_ago} weeks ago",

  "filofax_labels": {
    "ward_dossier_title": "WARD DOSSIER: {name}",
    "unsurveyed_header": "[!] UNSURVEYED TERRITORY",
    "unsurveyed_subtext": "Pre-1990: No digital directory or census roll available.\nStorefronts and beat patrol patterns are unknown.\nRequires physical reconnaissance on foot.",
    "dispatch_scout_btn": "Dispatch Runner to Walk Parade ({cost})",
    "data_age": "Field Notes Age: {age} week(s) old",
    "stale_warning": "[STALE PENCIL INTELLIGENCE]",
    "insufficient_funds": "Cannot dispatch runner: insufficient cash."
  },

"sections": [
    {
      "id": "demographics",
      "header_label": "MUNICIPAL CENSUS & RESIDENTS",
      "fields": [
        {
          "key": "active_population",
          "label": "Living Population",
          "format": "INTEGER",
          "suffix": " citizens"
        },
        {
          "key": "total_households",
          "label": "Registered Households",
          "format": "INTEGER",
          "suffix": " homes"
        },
        {
          "key": "formally_employed_count",
          "label": "Formally Employed",
          "format": "INTEGER",
          "suffix": " workers"
        },
        {
          "key": "street_informal_count",
          "label": "Informal / Dole Economy",
          "format": "INTEGER",
          "suffix": " claimants"
        },
        {
          "key": "incarcerated_count",
          "label": "Custodial Inmates",
          "format": "INTEGER",
          "suffix": " in HM Prison"
        }
      ]
    },
    {
      "id": "socioeconomic_telemetry",
      "header_label": "WARD TELEMETRY & PUBLIC ORDER",
      "fields": [
        {
          "key": "avg_disposable_income",
          "label": "Est. Weekly Disposable Income",
          "format": "CURRENCY",
          "prefix": "£",
          "suffix": " / wk"
        },
        {
          "key": "zone_health_index",
          "label": "Zone Health Index (ZHI)",
          "format": "FLOAT",
          "decimals": 1,
          "suffix": " / 100"
        },
        {
          "key": "actual_police_heat",
          "label": "Observed Police Patrol Heat",
          "format": "PERCENT",
          "decimals": 1
        },
        {
          "key": "unemployment_rate",
          "label": "Unemployment Ratio",
          "format": "PERCENT",
          "decimals": 1
        }
      ]
    }
  ],
  "establishment_section": {
    "header_label": "LOCAL TRADE & CIVIC ESTABLISHMENTS",
    "empty_text": "• Purely Residential / Undeveloped (No licensed trade or facilities)",
    "row_template": "• {name} [{category}]: Capacity {capacity}"
  },


  "styling": {
    "grid_columns": 2,
    "grid_h_separation": 16,
    "grid_v_separation": 4,
    "header_font_size": 13,
    "header_color": "#D4AF37",
    "label_color": "#B0B0B0",
    "value_color": "#FFFFFF",
    "empty_color": "#808080",
    "separator_alpha": 0.25
  }
}