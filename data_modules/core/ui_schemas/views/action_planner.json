{
  "_meta": {
    "module_type": "ACTION_PLANNER",
    "target_class": "GenActionPlanner",
    "extends": "VBoxContainer"
  },
  "has_action_queue": true,
  "sections": [
    {
      "id": "operational_docket",
      "header_token": "UI_HDR_OPERATIONS",
      "color": "body",
      "rows": [
        {
          "id": "active_operative_row",
          "type": "TEXT_METRIC",
          "token": "UI_LBL_ACTIVE_OPERATIVE",
          "field": "active_operative_display",
          "default_text": "Active Operative"
        },
        {
          "id": "btn_cycle_operative",
          "type": "BUTTON",
          "token": "UI_BTN_SWITCH_OPERATIVE",
          "default_text": "Switch Operative",
          "action_signal": "action_clicked",
          "emit_args": "\"cycle_planner_operative\""
        },
        {
          "id": "return_to_base_row",
          "type": "TEXT_METRIC",
          "token": "UI_LBL_RETURN_TO_BASE",
          "field": "return_to_base_display",
          "default_text": "Return to Base at Turn End"
        },
        {
          "id": "btn_toggle_return_base",
          "type": "BUTTON",
          "token": "UI_BTN_TOGGLE_RETURN_BASE",
          "default_text": "Toggle Return to Base",
          "action_signal": "action_clicked",
          "emit_args": "\"toggle_return_to_base\""
        },
        {
          "id": "btn_open_order_pad",
          "type": "BUTTON",
          "token": "UI_BTN_OPEN_ORDER_PAD",
          "action_signal": "action_clicked",
          "emit_args": "\"open_order_composer\""
        },
        {
          "id": "btn_save_standing_order",
          "type": "BUTTON",
          "token": "UI_BTN_SAVE_STANDING_ORDER",
          "action_signal": "action_clicked",
          "emit_args": "\"save_standing_order\""
        },
        {
          "id": "btn_pause_standing_orders",
          "type": "BUTTON",
          "token": "UI_BTN_PAUSE_STANDING_ORDERS",
          "action_signal": "action_clicked",
          "emit_args": "\"pause_standing_orders\""
        }
      ]
    },
    {
      "id": "staging_ledger",
      "header_token": "UI_HDR_STAGED_QUEUE",
      "color": "body",
      "rows": [
        {
          "id": "queue_list",
          "type": "ITEM_LIST",
          "token": "UI_LBL_QUEUED",
          "field": "staged_queue",
          "has_action_queue": true,
          "reorderable": true,
          "min_height": 140
        },
        {
          "id": "btn_select_all",
          "type": "BUTTON",
          "token": "UI_BTN_SELECT_ALL",
          "action_signal": "action_clicked",
          "emit_args": "\"select_all_directives\""
        }
      ]
    },
    {
      "id": "action_planner_signals",
      "type": "SIGNALS",
      "signals": [
        "directive_staged(directive)",
        "execute_shift_requested(staged_directives)",
        "action_clicked(action_code: String, payload: Dictionary)"
      ]
    }
  ]
}