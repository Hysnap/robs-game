{
  "_meta": {
    "target_class": "GenResidentialDocket",
    "extends": "VBoxContainer",
    "description": "Domestic tenancy and household census docket inspector",
    "signals": [
      "route_requested(domain_token: String, target_page_name: String)"
    ]
  },
  "sections": [
    {
      "id": "nav_controls",
      "rows": [
        {
          "id": "btn_back",
          "type": "BUTTON",
          "token": "UI_BTN_BACK_DOSSIER",
          "default_text": "⬅ Back to District Dossier",
          "action_signal": "route_requested",
          "emit_args": "\"DOSSIER\", \"\""
        }
      ]
    },
    {
      "id": "tenancy_identity",
      "rows": [
        {
          "id": "tenancy_header",
          "type": "HEADER_BLOCK",
          "field": "name",
          "subtitle_field": "residence_type",
          "title_font_size": 18,
          "subtitle_font_size": 12,
          "show_separator": true,
          "autowrap": true
        }
      ]
    },
    {
      "id": "tenancy_details",
      "header_token": "UI_HDR_TENANCY_STATUS",
      "header_default": "DOMESTIC TENANCY & HOUSEHOLD STATUS",
      "rows": [
        {
          "id": "door_num",
          "field": "unit_door_number",
          "type": "TEXT_METRIC",
          "token": "UI_LBL_DOOR_NUMBER",
          "default_text": "Door / Flat Number",
          "autowrap": true
        },
        {
          "id": "ward",
          "field": "district_name",
          "type": "TEXT_METRIC",
          "token": "UI_LBL_DISTRICT_WARD",
          "default_text": "Registered Ward",
          "autowrap": true
        },
        {
          "id": "local_pub",
          "field": "local_pub_name",
          "type": "TEXT_METRIC",
          "token": "UI_LBL_LOCAL_TAPROOM",
          "default_text": "Local Taproom Affinity",
          "autowrap": true
        }
      ]
    },
    {
      "id": "residents_roster",
      "header_token": "UI_HDR_HOUSEHOLD_RESIDENTS",
      "header_default": "RECORDED HOUSEHOLD OCCUPANTS",
      "rows": [
        {
          "id": "occupants_list",
          "type": "ITEM_LIST",
          "field": "residents_summary",
          "min_height": 120
        }
      ]
    }
  ]
}