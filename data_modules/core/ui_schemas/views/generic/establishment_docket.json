{
  "_meta": {
    "target_class": "GenEstablishmentDocket",
    "extends": "VBoxContainer",
    "description": "Commercial, civic, and industrial establishment docket inspector view",
    "signals": [
      "route_requested(domain_token: String, target_page_name: String)"
    ]
  },
  "sections": [
    {
      "id": "nav_controls",
      "rows": [
        {
          "id": "btn_back",
          "type": "BUTTON",
          "token": "UI_BTN_BACK_DOSSIER",
          "default_text": "⬅ Back to District Dossier",
          "action_signal": "route_requested",
          "emit_args": "\"DOSSIER\", \"\""
        }
      ]
    },
    {
      "id": "establishment_identity",
      "rows": [
        {
          "id": "estab_header",
          "type": "HEADER_BLOCK",
          "field": "name",
          "subtitle_field": "category_title",
          "title_font_size": 18,
          "subtitle_font_size": 12,
          "show_separator": true,
          "autowrap": true
        }
      ]
    },
    {
      "id": "location_and_scale",
      "header_token": "UI_HDR_VENUE_LOCATION",
      "header_default": "MUNICIPAL REGISTRATION & CAPACITY",
      "rows": [
        {
          "id": "ward",
          "field": "district_name",
          "type": "TEXT_METRIC",
          "token": "UI_LBL_DISTRICT_WARD",
          "default_text": "Registered Ward",
          "autowrap": true
        },
        {
          "id": "capacity",
          "field": "capacity",
          "type": "TEXT_METRIC",
          "format": "INT",
          "token": "UI_LBL_VENUE_CAPACITY",
          "default_text": "Operational Capacity",
          "suffix": " units",
          "autowrap": true
        }
      ]
    },
    {
      "id": "catchment_overview",
      "header_token": "UI_HDR_MARKET_CATCHMENT",
      "header_default": "LOCAL TRADE CATCHMENT (SURROUNDING 9 BLOCKS)",
      "rows": [
        {
          "id": "catchment_pop",
          "field": "total_catchment_population",
          "type": "TEXT_METRIC",
          "format": "INT",
          "suffix": " residents",
          "token": "UI_LBL_CATCHMENT_POPULATION",
          "default_text": "Potential Customers",
          "autowrap": true
        },
        {
          "id": "catchment_hh",
          "field": "total_catchment_households",
          "type": "TEXT_METRIC",
          "format": "INT",
          "suffix": " households",
          "token": "UI_LBL_CATCHMENT_HOUSEHOLDS",
          "default_text": "Customer Base",
          "autowrap": true
        },
        {
          "id": "catchment_income",
          "field": "avg_neighbor_disposable_income",
          "type": "TEXT_METRIC",
          "format": "CURRENCY",
          "token": "UI_LBL_NEIGHBORHOOD_INCOME",
          "default_text": "Avg Neighbor Income",
          "autowrap": true
        }
      ]
    },
    {
      "id": "personnel_overview",
      "header_token": "UI_HDR_ACTIVE_CONTRACTS",
      "header_default": "ACTIVE PERSONNEL & LIVELIHOOD CONTRACTS",
      "rows": [
        {
          "id": "personnel_list",
          "type": "ITEM_LIST",
          "field": "personnel_summary",
          "min_height": 100
        }
      ]
    }
  ]
}