{
  "_meta": {
    "target_class": "GenResidentialDocket",
    "extends": "VBoxContainer",
    "description": "Pocket index-card domestic tenancy and household census view"
  },
  "sections": [
    {
      "id": "nav_controls",
      "rows": [
        {
          "id": "btn_back",
          "type": "BUTTON",
          "token": "UI_BTN_BACK_DOSSIER",
          "font_size": 8,
          "action_signal": "action_clicked",
          "emit_args": "\"open_dossier\", {}"
        }
      ]
    },
    {
      "id": "tenancy_identity",
      "rows": [
        {
          "id": "tenancy_header",
          "type": "HEADER_BLOCK",
          "color": "body",
          "field": "name",
          "subtitle_field": "residence_type",
          "title_color": "body",
          "subtitle_color": "body",
          "title_font_size": 12,
          "subtitle_font_size": 10,
          "show_separator": true,
          "autowrap": true
        }
      ]
    },
    {
      "id": "tenancy_details",
      "header_token": "UI_HDR_TENANCY_STATUS",
      "font_size": 8,
      "color": "body",
      "rows": [
        {
          "id": "door_num",
          "field": "unit_door_number",
          "type": "TEXT_METRIC",
          "font_size": 8,
          "color": "body",
          "token": "UI_LBL_DOOR_NUMBER",
          "autowrap": true
        },
        {
          "id": "ward",
          "field": "district_name",
          "type": "TEXT_METRIC",
          "font_size": 8,
          "color": "body",
          "token": "UI_LBL_DISTRICT_WARD",
          "autowrap": true
        },
        {
          "id": "local_pub",
          "field": "local_pub_name",
          "type": "TEXT_METRIC",
          "font_size": 8,
          "color": "body",
          "token": "UI_LBL_LOCAL_TAPROOM",
          "autowrap": true
        }
      ]
    },
    {
      "id": "residents_roster",
      "header_token": "UI_HDR_HOUSEHOLD_RESIDENTS",
      "font_size": 8,
      "color": "body",
      "rows": [
        {
          "id": "occupants_list",
          "type": "ITEM_LIST",
          "font_size": 8,
          "color": "body",
          "field": "residents_summary",
          "min_height": 84
        }
      ]
    },
    {
      "id": "residential_doc_signals",
      "type": "SIGNALS",
      "signals": [
        "action_clicked(action_code: String, payload: Dictionary)"
      ]
    }
  ]
}