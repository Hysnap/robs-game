{
  "_meta": {
    "target_class": "GenEstablishmentDocket",
    "extends": "VBoxContainer",
    "description": "Pocket index-card commercial, civic, and industrial establishment view"
  },
  "sections": [
    {
      "id": "nav_controls",
      "rows": [
        {
          "id": "btn_back",
          "type": "BUTTON",
          "token": "UI_BTN_BACK_DOSSIER",
          "font_size": 8,
          "action_signal": "action_clicked",
          "emit_args": "\"open_dossier\", {}"
        }
      ]
    },
    {
      "id": "establishment_identity",
      "rows": [
        {
          "id": "estab_header",
          "type": "HEADER_BLOCK",
          "color": "body",
          "field": "name",
          "subtitle_field": "category_title",
          "title_color": "body",
          "subtitle_color": "body",
          "title_font_size": 12,
          "subtitle_font_size": 10,
          "show_separator": true,
          "autowrap": true
        }
      ]
    },
    {
      "id": "location_and_scale",
      "header_token": "UI_HDR_VENUE_LOCATION",
      "color": "body",
      "rows": [
        {
          "id": "ward",
          "field": "district_name",
          "type": "TEXT_METRIC",
          "color": "body",
          "font_size": 8,
          "token": "UI_LBL_DISTRICT_WARD",
          "autowrap": true
        },
        {
          "id": "capacity",
          "field": "capacity",
          "type": "TEXT_METRIC",
          "color": "body",
          "font_size": 8,
          "format": "INT",
          "token": "UI_LBL_VENUE_CAPACITY",
          "autowrap": true
        }
      ]
    },
    {
      "id": "catchment_overview",
      "header_token": "UI_HDR_MARKET_CATCHMENT",
      "font_size": 8,
      "color": "body",
      "rows": [
        {
          "id": "catchment_pop",
          "field": "total_catchment_population",
          "type": "TEXT_METRIC",
          "color": "body",
          "font_size": 8,
          "format": "INT",
          "token": "UI_LBL_CATCHMENT_POPULATION",
          "autowrap": true
        },
        {
          "id": "catchment_hh",
          "field": "total_catchment_households",
          "type": "TEXT_METRIC",
          "color": "body",
          "font_size": 8,
          "format": "INT",
          "token": "UI_LBL_CATCHMENT_HOUSEHOLDS",
          "autowrap": true
        },
        {
          "id": "catchment_income",
          "field": "avg_neighbor_disposable_income",
          "type": "TEXT_METRIC",
          "color": "body",
          "font_size": 8,
          "format": "CURRENCY",
          "token": "UI_LBL_NEIGHBORHOOD_INCOME",
          "autowrap": true
        }
      ]
    },
    {
      "id": "personnel_overview",
      "header_token": "UI_HDR_ACTIVE_CONTRACTS",
      "font_size": 8,
      "color": "body",
      "rows": [
        {
          "id": "personnel_list",
          "type": "ITEM_LIST",
          "font_size": 8,
          "field": "personnel_summary",
          "min_height": 76
        }
      ]
    },
    {
      "id": "establishment_docket_signals",
      "type": "SIGNALS",
      "signals": [
        "action_clicked(action_code: String, payload: Dictionary)"
      ]
    }
  ]
}