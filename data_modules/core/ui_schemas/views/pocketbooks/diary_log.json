{
  "_meta": {
    "target_class": "GenDiaryLog",
    "extends": "VBoxContainer",
    "description": "Pocket notebook dispatch diary and field entries with integrated calendar event navigator"
  },
  "sections": [
    {
      "id": "signals",
      "type": "SIGNALS",
      "signals": [
        "action_clicked(action_code, payload)"
      ]
    },
    {
      "id": "diary_header",
      "header_token": "UI_SEC_DISPATCH_DIARY",
      "color": "body",
      "font_size": 8,
      "rows": [
        {
          "id": "current_week",
          "field": "current_week_tick",
          "token": "UI_LBL_CURRENT_WEEK",
          "color": "body",
          "font_size": 8,
          "format": "INT",
          "autowrap": true
        },
        {
          "id": "dispatched_count",
          "field": "total_dispatched_orders",
          "token": "UI_LBL_DISPATCH_COUNT",
          "color": "body",
          "font_size": 8,
          "format": "INT",
          "autowrap": true
        }
      ]
    },
    {
      "id": "diary_calendar",
      "header_token": "UI_SEC_DIARY_CALENDAR",
      "color": "accent",
      "font_size": 8,
      "rows": [
        {
          "id": "calendar_nav",
          "type": "CALENDAR_NAVIGATOR",
          "field": "calendar_payload",
          "font_size": 8,
          "color": "body",
          "action_signal": "action_clicked"
        }
      ]
    },
    {
      "id": "inscriptions",
      "type": "INSCRIPTIONS",
      "font_size": 8,
      "color": "body",
      "header_token": "UI_SEC_DISPATCH_INSCRIPTIONS"
    }
  ]
}