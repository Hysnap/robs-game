{
  "_meta": {
    "target_class": "GenDiaryLog",
    "extends": "VBoxContainer",
    "description": "Pocket notebook dispatch diary and field entries"
  },
  "sections": [
    {
      "id": "diary_header",
      "header_token": "UI_SEC_DISPATCH_DIARY",
      "color": "body",
      "rows": [
        {
          "id": "current_week",
          "field": "current_week_tick",
          "token": "UI_LBL_CURRENT_WEEK",
          "color": "body",
          "format": "INT",
          "autowrap": true
        },
        {
          "id": "dispatched_count",
          "field": "total_dispatched_orders",
          "token": "UI_LBL_DISPATCH_COUNT",
          "color": "body",
          "format": "INT",
          "autowrap": true
        }
      ]
    },
    {
      "id": "inscriptions",
      "type": "INSCRIPTIONS",
      "header_token": "UI_SEC_DISPATCH_INSCRIPTIONS"
    }
  ]
}