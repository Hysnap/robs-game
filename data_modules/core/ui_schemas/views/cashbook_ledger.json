        { "id": "liquid_cash", "field": "reported_cash", "token": "UI_LBL_LIQUID_CASH", "default_text": "Liquid Cash Balance", "format": "CURRENCY", "suffix": "" },
        { "id": "filed_receipts_total", "field": "total_filed_expenses", "token": "UI_LBL_EXPENSE_TOTAL", "default_text": "Vouched Expenditures", "format": "CURRENCY", "suffix": "" }
      ]
    }
  ]
}