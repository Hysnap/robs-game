{
  "_meta": {
    "target_class": "GenRosterDocket",
    "extends": "VBoxContainer",
    "description": "Dossier and personnel register of recruited crew operatives and street confederates.",
    "signals": [
      "item_selected(target_route, filter_key)",
      "route_requested(domain_token, target_page_name)"
    ]
  },
  "sections": [
    {
      "id": "header_section",
      "header_token": "UI_HDR_CREW_DOSSIER",
      "header_default": "STREET CREW & ENTERPRISE ROSTER",
      "rows": [
        {
          "id": "crew_header",
          "type": "HEADER_BLOCK",
          "field": "enterprise_title",
          "subtitle_field": "home_district_name",
          "title_font_size": 18,
          "subtitle_font_size": 12,
          "show_separator": true,
          "autowrap": true
        }
      ]
    },
    {
      "id": "operative_list_section",
      "header_token": "UI_HDR_ACTIVE_OPERATIVES",
      "header_default": "ACTIVE CREW CADRE",
      "rows": [
        {
          "id": "operative_cards",
          "type": "LINKED_LIST",
          "field": "crew_members",
          "key_field": "resident_id",
          "target_route": "OPERATIVE_DETAIL",
          "label_field": "name",
          "sublabel_field": "summary_line",
          "action_signal": "item_selected",
          "autowrap": true
        }
      ]
    },
    {
      "id": "dossier_notes_section",
      "header_token": "UI_SEC_FIELD_OBSERVATIONS",
      "header_default": "DOSSIER FIELD NOTES",
      "rows": [
        {
          "id": "observations_box",
          "type": "INSCRIPTIONS_CONTAINER"
        }
      ]
    }
  ]
}