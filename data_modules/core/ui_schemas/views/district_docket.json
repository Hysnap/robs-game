{
  "_meta": {
    "target_class": "GenDistrictDocket",
    "extends": "VBoxContainer",
    "description": "District intelligence dossier inspector view"
  },
  "sections": [
    {
      "id": "ward_identity",
      "rows": [
        {
          "id": "docket_header",
          "type": "HEADER_BLOCK",
          "field": "display_name",
          "subtitle_field": "type_title",
          "title_font_size": 18,
          "subtitle_font_size": 12,
          "show_separator": true
        }
      ]
    },
    {
      "id": "intel_status_header",
      "header_token": "UI_HDR_SURVEY_INTELLIGENCE",
      "header_default": "WARD SURVEY & INTELLIGENCE AUDIT",
      "rows": [
        {
          "id": "survey_badge",
          "field": "intel_status_token",
          "type": "BADGE_STATUS",
          "format": "TOKEN",
          "token": "UI_LBL_INTEL_STATUS",
          "default_text": "INTELLIGENCE STATUS"
        }
      ]
    },
    {
      "id": "demographics_overview",
      "header_token": "UI_HDR_WARD_DEMOGRAPHICS",
      "header_default": "DISTRICT DEMOGRAPHICS & CENSUS",
      "rows": [
        {
          "id": "pop",
          "field": "active_population",
          "type": "TEXT_METRIC",
          "format": "INT",
          "suffix": " citizens",
          "token": "UI_LBL_ACTIVE_POPULATION",
          "default_text": "Estimated Population"
        },
        {
          "id": "households",
          "field": "total_households",
          "type": "TEXT_METRIC",
          "format": "INT",
          "suffix": " households",
          "token": "UI_LBL_TOTAL_HOUSEHOLDS",
          "default_text": "Recorded Households"
        },
        {
          "id": "unemployment_tier",
          "field": "unemployment_bucket_token",
          "type": "TEXT_METRIC",
          "format": "TOKEN",
          "token": "UI_LBL_UNEMPLOYMENT_TIER",
          "default_text": "Workforce Tension"
        },
        {
          "id": "income",
          "field": "income_bucket_token",
          "type": "TEXT_METRIC",
          "format": "TOKEN",
          "token": "UI_LBL_DISPOSABLE_INCOME",
          "default_text": "Avg Disposable Income"
        }
      ]
    },
    {
      "id": "civic_infrastructure",
      "header_token": "UI_HDR_CIVIC_FEATURES",
      "header_default": "CIVIC LANDMARKS & NOTABLE VENUES",
      "rows": [
        {
          "id": "civic_features",
          "field": "establishments_summary",
          "type": "CIVIC_SUMMARY",
          "token": "UI_LBL_CIVIC_SUMMARY",
          "default_text": "Key Establishments"
        }
      ]
    },
    {
      "id": "security_environment",
      "header_token": "UI_HDR_SECURITY_ENVIRONMENT",
      "header_default": "CIVIL ORDER & POLICE SCRUTINY",
      "rows": [
        {
          "id": "zhi",
          "field": "zone_health_bucket_token",
          "type": "TEXT_METRIC",
          "format": "TOKEN",
          "token": "UI_LBL_ZONE_HEALTH",
          "default_text": "Zone Health Index"
        },
        {
          "id": "heat",
          "field": "heat_bucket_token",
          "type": "TEXT_METRIC",
          "format": "TOKEN",
          "token": "UI_LBL_POLICE_HEAT",
          "default_text": "Constabulary Scrutiny"
        }
      ]
    },
    {
      "id": "field_observations",
      "header_token": "UI_SEC_FIELD_OBSERVATIONS",
      "header_default": "INSCRIBED FIELD OBSERVATIONS",
      "rows": [
        {
          "id": "observations_box",
          "type": "INSCRIPTIONS_CONTAINER"
        }
      ]
    }
  ]
}