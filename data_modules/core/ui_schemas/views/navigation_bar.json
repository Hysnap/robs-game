{
  "_meta": {
    "target_class": "GenNavBar",
    "extends": "VBoxContainer",
    "signals": [
      "action_clicked(action_code: String, payload: Dictionary)"
    ]
  },
  "sections": [
    {
      "id": "macro_tabs",
      "rows": [
        {
          "id": "diary",
          "type": "BUTTON",
          "token": "UI_TAB_MACRO_DIARY",
          "default_text": "DIARY",
          "action_signal": "action_clicked",
          "emit_args": "\"NAV_ROUTE\", {\"domain\": \"DIARY\"}"
        },
        {
          "id": "dossier",
          "type": "BUTTON",
          "token": "UI_TAB_MACRO_DOSSIER",
          "default_text": "DOSSIER",
          "action_signal": "action_clicked",
          "emit_args": "\"NAV_ROUTE\", {\"domain\": \"DOSSIER\"}"
        },
        {
          "id": "roster",
          "type": "BUTTON",
          "token": "UI_TAB_MACRO_ROSTER",
          "default_text": "ROSTER",
          "action_signal": "action_clicked",
          "emit_args": "\"NAV_ROUTE\", {\"domain\": \"ROSTER\"}"
        },
        {
          "id": "finance",
          "type": "BUTTON",
          "token": "UI_TAB_MACRO_FINANCE",
          "default_text": "ACCOUNTS",
          "action_signal": "action_clicked",
          "emit_args": "\"NAV_ROUTE\", {\"domain\": \"FINANCE\"}"
        }
      ]
    }
  ]
}