{
  "_meta": {
    "target_class": "GenNavBar",
    "extends": "VBoxContainer"
  },
  "sections": [
    {
      "id": "macro_tabs",
      "rows": [
        {
          "id": "diary",
          "type": "BUTTON",
          "token": "UI_TAB_MACRO_DIARY",
          "action_signal": "action_clicked",
          "emit_args": "\"open_diary\", {}"
        },
        {
          "id": "dossier",
          "type": "BUTTON",
          "token": "UI_TAB_MACRO_DOSSIER",
          "action_signal": "action_clicked",
          "emit_args": "\"open_dossier\", {}"
        },
        {
          "id": "roster",
          "type": "BUTTON",
          "token": "UI_TAB_MACRO_ROSTER",
          "action_signal": "action_clicked",
          "emit_args": "\"open_roster\", {}"
        },
        {
          "id": "family_bible",
          "type": "BUTTON",
          "token": "UI_TAB_MACRO_FAMILY_BIBLE",
          "action_signal": "action_clicked",
          "emit_args": "\"open_family_bible\", {}"
        },
        {
          "id": "finance",
          "type": "BUTTON",
          "token": "UI_TAB_MACRO_FINANCE",
          "action_signal": "action_clicked",
          "emit_args": "\"open_finance\", {}"
        },
        {
          "id": "styles",
          "type": "BUTTON",
          "token": "UI_TAB_MACRO_STYLES",
          "action_signal": "action_clicked",
          "emit_args": "\"toggle_styles\", {}"
        }
      ]
    },
    {
      "id": "nav_bar_signals",
      "type": "SIGNALS",
      "signals": [
        "action_clicked(action_code: String, payload: Dictionary)"
      ]
    }
  ]
}