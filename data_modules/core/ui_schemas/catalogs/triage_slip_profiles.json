{
  "_meta": {
    "module_type": "TRIAGE_SLIP_CATALOG",
    "description": "Configuration rules for translating abstract outcome triggers into physical desk slips"
  },
  "stack_rules": {
    "max_visible_cards": 4,
    "max_tilt_degrees": 45.0,
    "jitter_offset_px": 12.0
  },
  "slip_profiles": {
    "RECEIPT": {
      "palette_bg": "#FFF8DC",
      "font_size": 10,
      "ruled_lines": true,
      "default_filing_domain": "FINANCE",
      "evidence_base_weight": 0.08
    },
    "OPERATIONAL_DISPATCH": {
      "palette_bg": "#FFF899",
      "font_size": 10,
      "ruled_lines": false,
      "default_filing_domain": "DIARY",
      "evidence_base_weight": 0.05
    },
    "FIELD_MEMO": {
      "palette_bg": "#BFFCC6",
      "font_size": 10,
      "ruled_lines": false,
      "default_filing_domain": "DIARY",
      "evidence_base_weight": 0.04
    }
  }
}